FLASH_MODEL=gemini/gemini-2.0-flash

# --- Dual-Model Evolutionary Strategy ---
# task_manager/agent.py uses two model "roles" to drive the evolutionary loop
# (see LLM_SECONDARY_MODEL/LLM_PRIMARY_MODEL below): a fast/cheap model for
# broad, high-volume exploration (initial population + low-fitness mutations),
# and a stronger model for deep refinement of the most promising candidates
# and for bug-fixing (see HIGH_FITNESS_THRESHOLD_FOR_PRIMARY_LLM). Leave
# LLM_PRIMARY_MODEL/LLM_SECONDARY_MODEL unset to fall back to a single model
# (LITELLM_DEFAULT_MODEL) for everything.
#
# LLM_SECONDARY_MODEL: the "Flash" role - broad exploration.
LLM_SECONDARY_MODEL=gemini/gemini-2.0-flash
# LLM_PRIMARY_MODEL: the "Pro" role - deep refinement of high-fitness programs
# and bug-fixing. Defaults to LITELLM_DEFAULT_MODEL if unset, so set this
# explicitly to a stronger model or the two roles will collapse to the same
# model.
LLM_PRIMARY_MODEL=gemini/gemini-2.5-pro
# Correctness score (0.0-1.0) a parent program must reach before its
# mutations switch from LLM_SECONDARY_MODEL to LLM_PRIMARY_MODEL. Defaults to
# 0.8 in config/settings.py if unset.
# HIGH_FITNESS_THRESHOLD_FOR_PRIMARY_LLM=0.8

EVALUATION_MODEL=gpt-4o

# These are optional
# FLASH_BASE_URL=http://localhost:11434
# EVALUATION_BASE_URL=http://localhost:11434

# --- LiteLLM Configuration ---
# Default model string for litellm (e.g., "gpt-3.5-turbo", "ollama/mistral", "claude-3-haiku-20240307")
# See litellm documentation for more model strings: https://docs.litellm.ai/docs/providers
LITELLM_DEFAULT_MODEL="gemini/gemini-2.0-flash-lite"

# NOTE: litellm authenticates using its own provider-standard environment
# variables (picked up automatically from the model string's prefix), not
# per-role keys - so a single GEMINI_API_KEY below covers both
# LLM_SECONDARY_MODEL and LLM_PRIMARY_MODEL above whenever they're both
# "gemini/..." models. There is no separate FLASH_API_KEY/PRO_API_KEY.
GEMINI_API_KEY=""

# For Google Cloud services (Vertex AI, AI Studio) using Application Default Credentials (ADC)
# with a service account key, set the path to your JSON key file.
# This is often used in conjunction with models like "vertex_ai/gemini-1.5-pro-preview-0409".
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/your/service-account-key.json"

# API keys for models accessed via litellm should generally be set as environment variables
# that litellm recognizes (e.g., OPENAI_API_KEY, COHERE_API_KEY, ANTHROPIC_API_KEY, GOOGLE_API_KEY).
# litellm will automatically pick these up. Refer to litellm documentation for specific provider needs.
# Example:
# OPENAI_API_KEY=your_openai_api_key
# AZURE_API_KEY=your_azure_api_key # (for Azure OpenAI, also need other AZURE_* vars)

# LITELLM_MAX_TOKENS=4096
# LITELLM_TEMPERATURE=1.0
# LITELLM_TOP_P=0.9
# LITELLM_TOP_K=40
